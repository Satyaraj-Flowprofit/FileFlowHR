@page "/admin/sign-in"
@attribute [Authorize(Policy = Permissions.SettingsManage)]
@inherits HrComponentBase

<PageTitle>Sign-in settings</PageTitle>
<PageHeader Title="Sign-in settings" Subtitle="How this company's staff sign in. Applicants always use email and password." />
<Alerts Error="@ErrorMessage" Success="@SuccessMessage" />

@foreach (var p in providers.Where(p => p.Type == LoginProviderType.Password))
{
    var item = p;
    <div class="panel">
        <h2>Email and password (built in) <StatusBadge Text="@(item.IsEnabled ? "Active" : "Disabled")" /></h2>
        <p class="muted">For companies without their own login system. Passwords are stored hashed by ASP.NET Core Identity, never in plain text.</p>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="pw-enabled" @bind="passwordEnabled" />
            <label class="form-check-label" for="pw-enabled">Staff may sign in with a password</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="pw-mfa" @bind="requireMfa" />
            <label class="form-check-label" for="pw-mfa">Require an authenticator app (MFA) for staff</label>
        </div>
        <div class="actions-row"><button class="btn btn-primary" disabled="@Busy" @onclick="() => SavePassword(item.Id)">Save</button></div>
    </div>
}

<div class="panel">
    <h2>Company login (OpenID Connect)</h2>
    <p class="muted">Use the company's own Microsoft Entra ID, Okta, Google Workspace or similar. Staff are matched by email to an invited login. The client secret is not stored in the database: put it in configuration under <code>LoginSecrets:&lt;secret name&gt;</code>.</p>

    @foreach (var p in providers.Where(p => p.Type == LoginProviderType.Oidc))
    {
        var item = p;
        <div class="d-flex justify-content-between align-items-center border rounded p-2 mb-2">
            <div>
                <strong>@item.DisplayName</strong> <StatusBadge Text="@(item.IsEnabled ? "Active" : "Disabled")" />
                <div class="muted small">@item.Authority · client @item.ClientId@(item.EmailDomain is null ? "" : " · " + item.EmailDomain)</div>
            </div>
            <button class="btn btn-sm btn-link" @onclick="() => Edit(item)">Edit</button>
        </div>
    }

    <div class="form-grid mt-3">
        <div><label class="form-label">Button text</label><input class="form-control" @bind="oidc.DisplayName" placeholder="Sign in with Globex Microsoft" /></div>
        <div><label class="form-label">Authority (issuer URL)</label><input class="form-control" @bind="oidc.Authority" placeholder="https://login.microsoftonline.com/{tenant}/v2.0" /></div>
        <div><label class="form-label">Client ID</label><input class="form-control" @bind="oidc.ClientId" /></div>
        <div><label class="form-label">Secret name</label><input class="form-control" @bind="oidc.SecretName" placeholder="globex-entra" /></div>
        <div><label class="form-label">Email domain (optional)</label><input class="form-control" @bind="oidc.EmailDomain" placeholder="globex.com" /></div>
        <div class="form-check ms-1">
            <input class="form-check-input" type="checkbox" id="oidc-enabled" @bind="oidc.IsEnabled" />
            <label class="form-check-label" for="oidc-enabled">Enabled</label>
        </div>
    </div>
    <div class="actions-row">
        <button class="btn btn-primary" disabled="@Busy" @onclick="SaveOidc">@(oidc.Id is null ? "Add company login" : "Save company login")</button>
        @if (oidc.Id is not null) { <button class="btn btn-link" @onclick="() => oidc = new()">Cancel</button> }
    </div>
    <p class="muted small mt-2 mb-0">SAML is planned for later; most providers offer OpenID Connect today.</p>
</div>

@code {
    private IReadOnlyList<LoginProviderDto> providers = [];
    private bool passwordEnabled, requireMfa;
    private OidcForm oidc = new();

    private sealed class OidcForm { public long? Id; public string DisplayName = ""; public string Authority = ""; public string ClientId = ""; public string SecretName = ""; public string? EmailDomain; public bool IsEnabled = true; }

    protected override Task OnInitializedAsync() => Load();

    private async Task Load()
    {
        var result = await Send(new ListLoginProvidersQuery());
        if (!result.Succeeded) return;
        providers = result.Value!;
        if (providers.FirstOrDefault(p => p.Type == LoginProviderType.Password) is { } pw)
            (passwordEnabled, requireMfa) = (pw.IsEnabled, pw.RequireMfa);
    }

    private void Edit(LoginProviderDto p) => oidc = new()
    {
        Id = p.Id, DisplayName = p.DisplayName, Authority = p.Authority ?? "", ClientId = p.ClientId ?? "",
        SecretName = p.SecretName ?? "", EmailDomain = p.EmailDomain, IsEnabled = p.IsEnabled,
    };

    private async Task SavePassword(long id)
    {
        if ((await Send(new UpdatePasswordLoginCommand(id, passwordEnabled, requireMfa), "Password sign-in saved.")).Succeeded) await Load();
    }

    private async Task SaveOidc()
    {
        var result = await Send(new SaveOidcLoginCommand(oidc.Id, oidc.DisplayName, oidc.Authority, oidc.ClientId, oidc.SecretName, oidc.EmailDomain, oidc.IsEnabled), "Company login saved.");
        if (result.Succeeded) { oidc = new(); await Load(); }
    }
}

@* Password and confirmation inputs for static (non-interactive) forms. Values post back as Input.Password / Input.ConfirmPassword. *@
<div class="form-floating mb-3">
    <input type="password" name="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="New password" value="@Password" />
    <label for="Input.Password" class="form-label">New password</label>
</div>
<div class="form-floating mb-2">
    <input type="password" name="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm password" value="@ConfirmPassword" />
    <label for="Input.ConfirmPassword" class="form-label">Confirm password</label>
</div>
<p class="small text-secondary mb-3">At least 10 characters, with an upper-case letter, a lower-case letter, a number and a symbol.</p>

@code {
    [Parameter] public string? Password { get; set; }
    [Parameter] public string? ConfirmPassword { get; set; }
}
